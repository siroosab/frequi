{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "github": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "rewrites": [
    {
      "source": "/coinex-api/:path*",
      "destination": "https://api.coinex.com/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
